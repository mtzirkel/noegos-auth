# Database
DATABASE_URL=postgres://localhost:5432/noegos_auth

# JWT signing key (generate with: node -e "import('jose').then(j=>j.generateKeyPair('EdDSA').then(k=>j.exportJWK(k.privateKey).then(v=>console.log(JSON.stringify(v)))))")
JWT_PRIVATE_KEY=

# Cookie domain (set to .noegosunderwater.com in production)
COOKIE_DOMAIN=localhost

# Base URL of this auth service
AUTH_URL=http://localhost:5173

# Session duration in days
SESSION_DAYS=90
